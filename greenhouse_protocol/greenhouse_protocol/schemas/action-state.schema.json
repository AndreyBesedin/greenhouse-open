{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "$ref": "#/$defs/SetLevel"
        },
        {
          "$ref": "#/$defs/SetTarget"
        },
        {
          "$ref": "#/$defs/Water"
        },
        {
          "$ref": "#/$defs/Harvest"
        },
        {
          "$ref": "#/$defs/Lower"
        },
        {
          "$ref": "#/$defs/RemoveLeaf"
        },
        {
          "$ref": "#/$defs/Inspect"
        }
      ]
    },
    "ActionId": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "ActionRef": {
      "additionalProperties": false,
      "description": "Which action a record is about: a planned action, one occurrence of a\nrecurring one, or the fallback carried out in its place. `str()` spells\nit for people, `harvest@3` or `vent/fallback`; records keep the parts.",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/ActionId"
        },
        "occurrence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence"
        },
        "fallback": {
          "default": false,
          "title": "Fallback",
          "type": "boolean"
        }
      },
      "required": [
        "action_id"
      ],
      "title": "ActionRef",
      "type": "object"
    },
    "ActionStateKind": {
      "enum": [
        "waiting",
        "due",
        "assigned",
        "started"
      ],
      "title": "ActionStateKind",
      "type": "string"
    },
    "Asap": {
      "additionalProperties": false,
      "description": "As soon as what it waits for is done, before its deadline if it has\none.",
      "properties": {
        "kind": {
          "const": "asap",
          "default": "asap",
          "title": "Kind",
          "type": "string"
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Asap",
      "type": "object"
    },
    "At": {
      "additionalProperties": false,
      "description": "Due at an instant.",
      "properties": {
        "kind": {
          "const": "at",
          "default": "at",
          "title": "Kind",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Instant"
        }
      },
      "required": [
        "at"
      ],
      "title": "At",
      "type": "object"
    },
    "Harvest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "harvest",
          "default": "harvest",
          "title": "Kind",
          "type": "string"
        },
        "plant_id": {
          "$ref": "#/$defs/ItemName"
        },
        "scope": {
          "$ref": "#/$defs/HarvestScope"
        },
        "organ_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "plant_id",
        "scope"
      ],
      "title": "Harvest",
      "type": "object"
    },
    "HarvestScope": {
      "enum": [
        "ripe",
        "fruit",
        "truss"
      ],
      "title": "HarvestScope",
      "type": "string"
    },
    "Identifier": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "Inspect": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "inspect",
          "default": "inspect",
          "title": "Kind",
          "type": "string"
        },
        "plant_id": {
          "$ref": "#/$defs/ItemName"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "plant_id",
        "reason"
      ],
      "title": "Inspect",
      "type": "object"
    },
    "Instant": {
      "format": "date-time",
      "type": "string"
    },
    "ItemName": {
      "minLength": 1,
      "type": "string"
    },
    "Lower": {
      "additionalProperties": false,
      "description": "Lower a plant's stem: by so many centimetres, by so many internodes,\nor until its top has so much head room under its wire. Exactly one.",
      "properties": {
        "kind": {
          "const": "lower",
          "default": "lower",
          "title": "Kind",
          "type": "string"
        },
        "plant_id": {
          "$ref": "#/$defs/ItemName"
        },
        "by_cm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By Cm"
        },
        "by_internodes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By Internodes"
        },
        "to_head_room_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Head Room M"
        }
      },
      "required": [
        "plant_id"
      ],
      "title": "Lower",
      "type": "object"
    },
    "Name": {
      "minLength": 1,
      "type": "string"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "Who asks for an action, by identity: a person, a control policy, a\nschedule, a scenario's own plan, a platform.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PrincipalKind"
        },
        "id": {
          "$ref": "#/$defs/Name"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Principal",
      "type": "object"
    },
    "PrincipalKind": {
      "enum": [
        "person",
        "policy",
        "schedule",
        "scenario",
        "platform"
      ],
      "title": "PrincipalKind",
      "type": "string"
    },
    "RemoveLeaf": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "remove_leaf",
          "default": "remove_leaf",
          "title": "Kind",
          "type": "string"
        },
        "plant_id": {
          "$ref": "#/$defs/ItemName"
        },
        "leaf_id": {
          "$ref": "#/$defs/ItemName"
        }
      },
      "required": [
        "plant_id",
        "leaf_id"
      ],
      "title": "RemoveLeaf",
      "type": "object"
    },
    "RunEpoch": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "epoch"
      ],
      "title": "RunEpoch",
      "type": "object"
    },
    "SetLevel": {
      "additionalProperties": false,
      "description": "A device's level, from 0 (off) to 1 (full), or `auto` to hand the\ndevice back to whatever control loop runs it. A door or vent is a\ndevice, its level how far it is open.",
      "properties": {
        "kind": {
          "const": "set_level",
          "default": "set_level",
          "title": "Kind",
          "type": "string"
        },
        "device_id": {
          "$ref": "#/$defs/ItemName"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "const": "auto",
              "type": "string"
            }
          ],
          "title": "Level"
        }
      },
      "required": [
        "device_id",
        "level"
      ],
      "title": "SetLevel",
      "type": "object"
    },
    "SetTarget": {
      "additionalProperties": false,
      "description": "A climate controller's heating setpoint, by day or by night, in °C.\nEach kind of target has its own unit and range: the venting and humidity\ntargets, when a controller has them, are members of their own beside\nthis one.",
      "properties": {
        "kind": {
          "const": "set_target",
          "default": "set_target",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "enum": [
            "heating_day",
            "heating_night"
          ],
          "title": "Target",
          "type": "string"
        },
        "value_c": {
          "maximum": 40.0,
          "minimum": 0.0,
          "title": "Value C",
          "type": "number"
        }
      },
      "required": [
        "target",
        "value_c"
      ],
      "title": "SetTarget",
      "type": "object"
    },
    "Timing": {
      "oneOf": [
        {
          "$ref": "#/$defs/At"
        },
        {
          "$ref": "#/$defs/Window"
        },
        {
          "$ref": "#/$defs/Asap"
        }
      ]
    },
    "Water": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "water",
          "default": "water",
          "title": "Kind",
          "type": "string"
        },
        "plant_id": {
          "$ref": "#/$defs/ItemName"
        },
        "amount_ml": {
          "exclusiveMinimum": 0.0,
          "maximum": 2000.0,
          "title": "Amount Ml",
          "type": "number"
        }
      },
      "required": [
        "plant_id",
        "amount_ml"
      ],
      "title": "Water",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "description": "Due between two instants: it starts at the earliest one in them an\nexecutor can honour and is free to take.",
      "properties": {
        "kind": {
          "const": "window",
          "default": "window",
          "title": "Kind",
          "type": "string"
        },
        "not_before": {
          "$ref": "#/$defs/Instant"
        },
        "not_after": {
          "$ref": "#/$defs/Instant"
        }
      },
      "required": [
        "not_before",
        "not_after"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An action not yet resolved, as it stands: what a gateway lists. Once\nresolved, it is an outcome in the outcome log, not a state.",
  "properties": {
    "plan_id": {
      "$ref": "#/$defs/Identifier"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "ref": {
      "$ref": "#/$defs/ActionRef"
    },
    "action": {
      "$ref": "#/$defs/Action"
    },
    "timing": {
      "$ref": "#/$defs/Timing"
    },
    "due": {
      "anyOf": [
        {
          "$ref": "#/$defs/Instant"
        },
        {
          "$ref": "#/$defs/Window"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due"
    },
    "principal": {
      "$ref": "#/$defs/Principal"
    },
    "state": {
      "$ref": "#/$defs/ActionStateKind"
    },
    "waiting_for": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ActionRef"
      },
      "title": "Waiting For",
      "type": "array"
    },
    "waited_on_by": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ActionRef"
      },
      "title": "Waited On By",
      "type": "array"
    },
    "carried_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunEpoch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "plan_id",
    "revision",
    "ref",
    "action",
    "timing",
    "principal",
    "state"
  ],
  "title": "ActionState",
  "type": "object"
}
