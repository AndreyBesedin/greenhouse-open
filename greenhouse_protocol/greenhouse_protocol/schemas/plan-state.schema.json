{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "$ref": "#/$defs/SetLevel"
        },
        {
          "$ref": "#/$defs/SetTarget"
        },
        {
          "$ref": "#/$defs/Water"
        },
        {
          "$ref": "#/$defs/Harvest"
        },
        {
          "$ref": "#/$defs/Lower"
        },
        {
          "$ref": "#/$defs/RemoveLeaf"
        },
        {
          "$ref": "#/$defs/Inspect"
        }
      ]
    },
    "ActionEffect": {
      "oneOf": [
        {
          "$ref": "#/$defs/LevelSet"
        },
        {
          "$ref": "#/$defs/TargetSet"
        },
        {
          "$ref": "#/$defs/Watered"
        },
        {
          "$ref": "#/$defs/Harvested"
        },
        {
          "$ref": "#/$defs/Lowered"
        },
        {
          "$ref": "#/$defs/LeafRemoved"
        },
        {
          "$ref": "#/$defs/Inspected"
        }
      ]
    },
    "ActionId": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "ActionOutcome": {
      "additionalProperties": false,
      "description": "One planned action's end. Its fields agree with its status: an action\nthat ran has its times and its executor; one that never started has\nneither, and says why; only a cancelled or superseded one names who did\nit, only a missed one its fallback, only one that ran its effect, which\nis its action's kind's. `resolved_at`, when the outcome was decided, is\nalways set and orders the log; `due` is None only for an\nas-soon-as-possible action dropped before it could start.",
      "properties": {
        "outcome_id": {
          "$ref": "#/$defs/Identifier"
        },
        "greenhouse_id": {
          "$ref": "#/$defs/Name"
        },
        "run_id": {
          "$ref": "#/$defs/Name"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "plan_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "ref": {
          "$ref": "#/$defs/ActionRef"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "status": {
          "$ref": "#/$defs/OutcomeStatus"
        },
        "due": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ],
          "title": "Due"
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at": {
          "$ref": "#/$defs/Instant"
        },
        "delivered_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "executor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "cancelled_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Principal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionEffect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Name"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "outcome_id",
        "greenhouse_id",
        "run_id",
        "epoch",
        "plan_id",
        "revision",
        "ref",
        "action",
        "timing",
        "principal",
        "status",
        "due",
        "resolved_at"
      ],
      "title": "ActionOutcome",
      "type": "object"
    },
    "ActionRef": {
      "additionalProperties": false,
      "description": "Which action a record is about: a planned action, one occurrence of a\nrecurring one, or the fallback carried out in its place. `str()` spells\nit for people, `harvest@3` or `vent/fallback`; records keep the parts.",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/ActionId"
        },
        "occurrence": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence"
        },
        "fallback": {
          "default": false,
          "title": "Fallback",
          "type": "boolean"
        }
      },
      "required": [
        "action_id"
      ],
      "title": "ActionRef",
      "type": "object"
    },
    "ActionState": {
      "additionalProperties": false,
      "description": "An action not yet resolved, as it stands: what a gateway lists. Once\nresolved, it is an outcome in the outcome log, not a state.",
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "ref": {
          "$ref": "#/$defs/ActionRef"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        },
        "due": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "state": {
          "$ref": "#/$defs/ActionStateKind"
        },
        "waiting_for": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionRef"
          },
          "title": "Waiting For",
          "type": "array"
        },
        "waited_on_by": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionRef"
          },
          "title": "Waited On By",
          "type": "array"
        },
        "carried_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunEpoch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "plan_id",
        "revision",
        "ref",
        "action",
        "timing",
        "principal",
        "state"
      ],
      "title": "ActionState",
      "type": "object"
    },
    "ActionStateKind": {
      "enum": [
        "waiting",
        "due",
        "assigned",
        "started"
      ],
      "title": "ActionStateKind",
      "type": "string"
    },
    "Asap": {
      "additionalProperties": false,
      "description": "As soon as what it waits for is done, before its deadline if it has\none.",
      "properties": {
        "kind": {
          "const": "asap",
          "default": "asap",
          "title": "Kind",
          "type": "string"
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Asap",
      "type": "object"
    },
    "At": {
      "additionalProperties": false,
      "description": "Due at an instant.",
      "properties": {
        "kind": {
          "const": "at",
          "default": "at",
          "title": "Kind",
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/Instant"
        }
      },
      "required": [
        "at"
      ],
      "title": "At",
      "type": "object"
    },
    "AuthorisationChange": {
      "additionalProperties": false,
      "description": "Which authorisation configuration a gateway put in force, and when.",
      "properties": {
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "at": {
          "$ref": "#/$defs/Instant"
        }
      },
      "required": [
        "version",
        "at"
      ],
      "title": "AuthorisationChange",
      "type": "object"
    },
    "ExecutorKind": {
      "enum": [
        "simulated_run",
        "person",
        "robot",
        "climate_computer"
      ],
      "title": "ExecutorKind",
      "type": "string"
    },
    "ExecutorRef": {
      "additionalProperties": false,
      "description": "Who carries an action out: a kind of executor, and which one, or any\nof the kind when `id` is None.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExecutorKind"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Name"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "ExecutorRef",
      "type": "object"
    },
    "Harvest": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "organ_id": {
            "type": "string"
          }
        },
        "required": [
          "organ_id"
        ]
      },
      "if": {
        "properties": {
          "scope": {
            "const": "ripe"
          }
        }
      },
      "properties": {
        "kind": {
          "const": "harvest",
          "default": "harvest",
          "title": "Kind",
          "type": "string"
        },
        "plant_id": {
          "$ref": "#/$defs/ItemName"
        },
        "scope": {
          "$ref": "#/$defs/HarvestScope"
        },
        "organ_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "plant_id",
        "scope"
      ],
      "then": {
        "properties": {
          "organ_id": {
            "type": "null"
          }
        }
      },
      "title": "Harvest",
      "type": "object"
    },
    "HarvestScope": {
      "enum": [
        "ripe",
        "fruit",
        "truss"
      ],
      "title": "HarvestScope",
      "type": "string"
    },
    "Harvested": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "harvested",
          "default": "harvested",
          "title": "Kind",
          "type": "string"
        },
        "fruit_count": {
          "minimum": 0,
          "title": "Fruit Count",
          "type": "integer"
        },
        "fresh_mass_g": {
          "minimum": 0.0,
          "title": "Fresh Mass G",
          "type": "number"
        }
      },
      "required": [
        "fruit_count",
        "fresh_mass_g"
      ],
      "title": "Harvested",
      "type": "object"
    },
    "Identifier": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "IfPrerequisiteFails": {
      "enum": [
        "cancel",
        "proceed"
      ],
      "title": "IfPrerequisiteFails",
      "type": "string"
    },
    "Inspect": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "inspect",
          "default": "inspect",
          "title": "Kind",
          "type": "string"
        },
        "plant_id": {
          "$ref": "#/$defs/ItemName"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "plant_id",
        "reason"
      ],
      "title": "Inspect",
      "type": "object"
    },
    "Inspected": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "inspected",
          "default": "inspected",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "Inspected",
      "type": "object"
    },
    "Instant": {
      "format": "date-time",
      "type": "string"
    },
    "ItemName": {
      "minLength": 1,
      "type": "string"
    },
    "Lateness": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "fallback": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "on_late": {
            "const": "fallback"
          }
        },
        "required": [
          "on_late"
        ]
      },
      "properties": {
        "tolerance_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Tolerance S",
          "type": "number"
        },
        "on_late": {
          "$ref": "#/$defs/OnLate",
          "default": "run_late"
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Action"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "then": {
        "properties": {
          "fallback": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "fallback"
        ]
      },
      "title": "Lateness",
      "type": "object"
    },
    "LeafRemoved": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "leaf_removed",
          "default": "leaf_removed",
          "title": "Kind",
          "type": "string"
        },
        "leaf_id": {
          "$ref": "#/$defs/Name"
        }
      },
      "required": [
        "leaf_id"
      ],
      "title": "LeafRemoved",
      "type": "object"
    },
    "LevelSet": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "level_set",
          "default": "level_set",
          "title": "Kind",
          "type": "string"
        },
        "device_id": {
          "$ref": "#/$defs/Name"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "const": "auto",
              "type": "string"
            }
          ],
          "title": "Level"
        }
      },
      "required": [
        "device_id",
        "level"
      ],
      "title": "LevelSet",
      "type": "object"
    },
    "Lower": {
      "additionalProperties": false,
      "description": "Lower a plant's stem: by so many centimetres, by so many internodes,\nor until its top has so much head room under its wire. Exactly one.",
      "oneOf": [
        {
          "properties": {
            "by_cm": {
              "type": "number"
            }
          },
          "required": [
            "by_cm"
          ]
        },
        {
          "properties": {
            "by_internodes": {
              "type": "integer"
            }
          },
          "required": [
            "by_internodes"
          ]
        },
        {
          "properties": {
            "to_head_room_m": {
              "type": "number"
            }
          },
          "required": [
            "to_head_room_m"
          ]
        }
      ],
      "properties": {
        "kind": {
          "const": "lower",
          "default": "lower",
          "title": "Kind",
          "type": "string"
        },
        "plant_id": {
          "$ref": "#/$defs/ItemName"
        },
        "by_cm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By Cm"
        },
        "by_internodes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By Internodes"
        },
        "to_head_room_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Head Room M"
        }
      },
      "required": [
        "plant_id"
      ],
      "title": "Lower",
      "type": "object"
    },
    "Lowered": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lowered",
          "default": "lowered",
          "title": "Kind",
          "type": "string"
        },
        "by_cm": {
          "minimum": 0.0,
          "title": "By Cm",
          "type": "number"
        }
      },
      "required": [
        "by_cm"
      ],
      "title": "Lowered",
      "type": "object"
    },
    "Name": {
      "minLength": 1,
      "type": "string"
    },
    "OnLate": {
      "description": "What a gateway does with an action that cannot start by its due\ninstant and tolerance.",
      "enum": [
        "run_late",
        "skip",
        "critical",
        "fallback",
        "abort_plan"
      ],
      "title": "OnLate",
      "type": "string"
    },
    "OutcomeStatus": {
      "enum": [
        "executed",
        "late",
        "missed",
        "refused",
        "failed",
        "cancelled",
        "superseded",
        "unconfirmed"
      ],
      "title": "OutcomeStatus",
      "type": "string"
    },
    "Plan": {
      "additionalProperties": false,
      "description": "The actions a run is to carry out, given in one of its epochs as one\nrevision of a plan. A revision replaces, from an instant on, the actions\nof the one before that have not started (the gateway's rule).\n\nChecked as made: action ids unique, every prerequisite in the plan, no\ncycle. Edges between recurring actions pair their occurrences, so two\nrecurring actions may wait for one another only if they recur alike,\noccurrence `n` for occurrence `n`; a recurring action may wait for a\none-off one, each occurrence for it; a one-off action may not wait for a\nrecurring one, since which occurrence is meant is not said. With those\nedges the plan, expanded occurrence by occurrence, has a cycle only if it\nhas one as given, so it is checked as given.",
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/Identifier"
        },
        "run_id": {
          "$ref": "#/$defs/Name"
        },
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/PlannedAction"
          },
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "run_id",
        "epoch",
        "revision",
        "actions"
      ],
      "title": "Plan",
      "type": "object"
    },
    "PlannedAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "$ref": "#/$defs/ActionId"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "timing": {
          "$ref": "#/$defs/Timing"
        },
        "every": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recurrence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "after": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionId"
          },
          "title": "After",
          "type": "array"
        },
        "if_prerequisite_fails": {
          "$ref": "#/$defs/IfPrerequisiteFails",
          "default": "cancel"
        },
        "lateness": {
          "$ref": "#/$defs/Lateness",
          "default": {
            "tolerance_s": 0.0,
            "on_late": "run_late",
            "fallback": null
          }
        },
        "expected_duration_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Duration S"
        },
        "executed_by": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExecutorRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executed By"
        },
        "proposed_by": {
          "$ref": "#/$defs/Principal"
        }
      },
      "required": [
        "action_id",
        "action",
        "timing",
        "proposed_by"
      ],
      "title": "PlannedAction",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "Who asks for an action, by identity: a person, a control policy, a\nschedule, a scenario's own plan, a platform.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PrincipalKind"
        },
        "id": {
          "$ref": "#/$defs/Name"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Principal",
      "type": "object"
    },
    "PrincipalKind": {
      "enum": [
        "person",
        "policy",
        "schedule",
        "scenario",
        "platform"
      ],
      "title": "PrincipalKind",
      "type": "string"
    },
    "Recurrence": {
      "additionalProperties": false,
      "description": "Every `period`, `count` times or until an instant: occurrence `n`,\nfrom 0, is the planned action's timing moved by `n` periods. The timing\nis its one anchor.",
      "oneOf": [
        {
          "properties": {
            "count": {
              "type": "integer"
            }
          },
          "required": [
            "count"
          ]
        },
        {
          "properties": {
            "until": {
              "type": "string"
            }
          },
          "required": [
            "until"
          ]
        }
      ],
