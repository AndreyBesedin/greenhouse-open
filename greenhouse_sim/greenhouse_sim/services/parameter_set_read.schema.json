{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SetNamed": {
      "additionalProperties": false,
      "description": "A set as another names it: its name, its version and its digest.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "digest"
      ],
      "title": "SetNamed",
      "type": "object"
    }
  },
  "description": "A set as it is read: as listed, with the values it changes from its\nbase and why each, and every value it resolves to, by its model's\nparameters' fields.",
  "properties": {
    "model": {
      "title": "Model",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "digest": {
      "title": "Digest",
      "type": "string"
    },
    "based_on": {
      "anyOf": [
        {
          "$ref": "#/$defs/SetNamed"
        },
        {
          "type": "null"
        }
      ]
    },
    "made_for": {
      "title": "Made For",
      "type": "integer"
    },
    "cultivar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cultivar"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "published": {
      "title": "Published",
      "type": "boolean"
    },
    "parameters": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Parameters",
      "type": "object"
    },
    "why": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Why",
      "type": "object"
    },
    "values": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Values",
      "type": "object"
    }
  },
  "required": [
    "model",
    "name",
    "version",
    "digest",
    "based_on",
    "made_for",
    "cultivar",
    "description",
    "published",
    "parameters",
    "why",
    "values"
  ],
  "title": "SetRead",
  "type": "object"
}
