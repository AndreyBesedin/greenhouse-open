{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "description": "Why a worker did not act on a request it took, in its own words.",
      "properties": {
        "request": {
          "title": "Request",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "request",
        "reason"
      ],
      "title": "Answer",
      "type": "object"
    },
    "JsonValue": {},
    "LogEntry": {
      "additionalProperties": false,
      "description": "A change given to an epoch while it ran: its number in the log, the\ninstant it takes effect, the moment of the epoch's clock it was given at,\nwho gave it, what it is, and the request it answers if it was asked for\nthrough the store. It is applied again at the moment it was given, so\nthat the epoch it makes is the same whenever it is worked out.",
      "properties": {
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "at_s": {
          "title": "At S",
          "type": "number"
        },
        "given_s": {
          "title": "Given S",
          "type": "number"
        },
        "by": {
          "title": "By",
          "type": "string"
        },
        "what": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "What",
          "type": "object"
        },
        "request": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request"
        }
      },
      "required": [
        "seq",
        "at_s",
        "given_s",
        "by",
        "what",
        "request"
      ],
      "title": "LogEntry",
      "type": "object"
    },
    "Status": {
      "enum": [
        "queued",
        "running",
        "finished",
        "failed",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "description": "What has become of the changes asked of an epoch: those logged, in\norder, those refused, and those no worker has taken yet. An epoch that has\nended takes no more: whatever is still waiting then is never taken.",
  "properties": {
    "status": {
      "$ref": "#/$defs/Status"
    },
    "log": {
      "items": {
        "$ref": "#/$defs/LogEntry"
      },
      "title": "Log",
      "type": "array"
    },
    "refused": {
      "items": {
        "$ref": "#/$defs/Answer"
      },
      "title": "Refused",
      "type": "array"
    },
    "waiting": {
      "items": {
        "type": "string"
      },
      "title": "Waiting",
      "type": "array"
    }
  },
  "required": [
    "status",
    "log",
    "refused",
    "waiting"
  ],
  "title": "EpochChanges",
  "type": "object"
}
