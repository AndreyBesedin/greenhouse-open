{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BoxPrimitive": {
      "additionalProperties": false,
      "description": "A box standing on the floor or anything else: its base centred on\n`base`, turned about the vertical by `heading` radians from the\ngreenhouse's x.",
      "properties": {
        "fixture_id": {
          "title": "Fixture Id",
          "type": "string"
        },
        "material": {
          "anyOf": [
            {
              "$ref": "#/$defs/Material"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "obstructs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Obstruction"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obstructs"
        },
        "primitive": {
          "const": "box",
          "default": "box",
          "title": "Primitive",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FixtureKind",
          "default": "obstacle"
        },
        "base": {
          "$ref": "#/$defs/Vector3"
        },
        "size_x": {
          "exclusiveMinimum": 0,
          "title": "Size X",
          "type": "number"
        },
        "size_y": {
          "exclusiveMinimum": 0,
          "title": "Size Y",
          "type": "number"
        },
        "size_z": {
          "exclusiveMinimum": 0,
          "title": "Size Z",
          "type": "number"
        },
        "heading": {
          "default": 0.0,
          "title": "Heading",
          "type": "number"
        }
      },
      "required": [
        "fixture_id",
        "material",
        "obstructs",
        "primitive",
        "kind",
        "base",
        "size_x",
        "size_y",
        "size_z",
        "heading"
      ],
      "title": "BoxPrimitive",
      "type": "object"
    },
    "Camera": {
      "additionalProperties": false,
      "description": "A camera at its position, looking at `target`, with its intrinsics.",
      "properties": {
        "sensor_id": {
          "description": "Letters, digits, '_', '.' and '-' only: the API's parameters write it between ':' and ','.",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Sensor Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Vector3"
        },
        "cadence_s": {
          "default": 60.0,
          "minimum": 1.0,
          "title": "Cadence S",
          "type": "number"
        },
        "kind": {
          "const": "camera",
          "default": "camera",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Vector3"
        },
        "intrinsics": {
          "$ref": "#/$defs/CameraIntrinsics"
        }
      },
      "required": [
        "sensor_id",
        "position",
        "cadence_s",
        "kind",
        "target",
        "intrinsics"
      ],
      "title": "Camera",
      "type": "object"
    },
    "CameraIntrinsics": {
      "description": "Pinhole intrinsics of one image stream, in pixels, with the\ncalibration's distortion coefficients exactly as given.",
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "fx": {
          "exclusiveMinimum": 0,
          "title": "Fx",
          "type": "number"
        },
        "fy": {
          "exclusiveMinimum": 0,
          "title": "Fy",
          "type": "number"
        },
        "ppx": {
          "title": "Ppx",
          "type": "number"
        },
        "ppy": {
          "title": "Ppy",
          "type": "number"
        },
        "distortion": {
          "default": [],
          "items": {
            "type": "number"
          },
          "title": "Distortion",
          "type": "array"
        }
      },
      "required": [
        "width",
        "height",
        "fx",
        "fy",
        "ppx",
        "ppy",
        "distortion"
      ],
      "title": "CameraIntrinsics",
      "type": "object"
    },
    "CropModel": {
      "description": "How a scenario's run grows its crop: by the simple daily model,\nthrough the engine, or organ by organ (`greenhouse_sim.core.crop`).",
      "enum": [
        "simple",
        "organ"
      ],
      "title": "CropModel",
      "type": "string"
    },
    "CropRows": {
      "additionalProperties": false,
      "description": "Parallel rows of planting positions, in metres and radians.",
      "properties": {
        "origin": {
          "$ref": "#/$defs/Point2"
        },
        "heading": {
          "default": 0.0,
          "title": "Heading",
          "type": "number"
        },
        "rows": {
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Rows",
          "type": "integer"
        },
        "positions_per_row": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Positions Per Row",
          "type": "integer"
        },
        "plant_pitch": {
          "exclusiveMinimum": 0,
          "title": "Plant Pitch",
          "type": "number"
        },
        "row_spacing": {
          "exclusiveMinimum": 0,
          "title": "Row Spacing",
          "type": "number"
        },
        "pair_gap": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Gap"
        },
        "support": {
          "anyOf": [
            {
              "$ref": "#/$defs/RowSupport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rails": {
          "anyOf": [
            {
              "$ref": "#/$defs/RowRails"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wires": {
          "anyOf": [
            {
              "$ref": "#/$defs/CropWires"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "origin",
        "heading",
        "rows",
        "positions_per_row",
        "plant_pitch",
        "row_spacing",
        "pair_gap",
        "support",
        "rails",
        "wires"
      ],
      "title": "CropRows",
      "type": "object"
    },
    "CropWires": {
      "additionalProperties": false,
      "description": "A crop wire above each run of a row's positions, `height` above the\nfloor, which the plants are trained up to; or, `offset` to either side\nof the row, a pair of them, a high-wire double row's, which its plants\nare trained to by turns (`greenhouse_sim.world.training`).",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "radius": {
          "default": 0.0025,
          "exclusiveMinimum": 0,
          "title": "Radius",
          "type": "number"
        },
        "offset": {
          "default": 0.0,
          "minimum": 0,
          "title": "Offset",
          "type": "number"
        }
      },
      "required": [
        "height",
        "radius",
        "offset"
      ],
      "title": "CropWires",
      "type": "object"
    },
    "CylinderPrimitive": {
      "additionalProperties": false,
      "description": "An upright cylinder, its base centred on `base`.",
      "properties": {
        "fixture_id": {
          "title": "Fixture Id",
          "type": "string"
        },
        "material": {
          "anyOf": [
            {
              "$ref": "#/$defs/Material"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "obstructs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Obstruction"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obstructs"
        },
        "primitive": {
          "const": "cylinder",
          "default": "cylinder",
          "title": "Primitive",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FixtureKind",
          "default": "obstacle"
        },
        "base": {
          "$ref": "#/$defs/Vector3"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "title": "Radius",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "fixture_id",
        "material",
        "obstructs",
        "primitive",
        "kind",
        "base",
        "radius",
        "height"
      ],
      "title": "CylinderPrimitive",
      "type": "object"
    },
    "Dehumidifier": {
      "additionalProperties": false,
      "description": "A dehumidifier: the water it takes out of the air at full power, and\nthe heat it gives the air while it does.",
      "properties": {
        "actuator_id": {
          "description": "Letters, digits, '_', '.' and '-' only: the API's parameters write it between ':' and ','.",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Actuator Id",
          "type": "string"
        },
        "heading": {
          "default": 0.0,
          "title": "Heading",
          "type": "number"
        },
        "base": {
          "$ref": "#/$defs/Vector3"
        },
        "size_x": {
          "exclusiveMinimum": 0,
          "title": "Size X",
          "type": "number"
        },
        "size_y": {
          "exclusiveMinimum": 0,
          "title": "Size Y",
          "type": "number"
        },
        "size_z": {
          "exclusiveMinimum": 0,
          "title": "Size Z",
          "type": "number"
        },
        "kind": {
          "const": "dehumidifier",
          "default": "dehumidifier",
          "title": "Kind",
          "type": "string"
        },
        "removal_kg_h": {
          "exclusiveMinimum": 0,
          "title": "Removal Kg H",
          "type": "number"
        },
        "heat_w": {
          "exclusiveMinimum": 0,
          "title": "Heat W",
          "type": "number"
        }
      },
      "required": [
        "actuator_id",
        "heading",
        "base",
        "size_x",
        "size_y",
        "size_z",
        "kind",
        "removal_kg_h",
        "heat_w"
      ],
      "title": "Dehumidifier",
      "type": "object"
    },
    "Envelope": {
      "description": "A greenhouse's envelope, in metres, no larger than any greenhouse.",
      "properties": {
        "length": {
          "exclusiveMinimum": 0,
          "maximum": 500.0,
          "title": "Length",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 500.0,
          "title": "Width",
          "type": "number"
        },
        "eave_height": {
          "exclusiveMinimum": 0,
          "maximum": 50.0,
          "title": "Eave Height",
          "type": "number"
        },
        "ridge_height": {
          "exclusiveMinimum": 0,
          "maximum": 50.0,
          "title": "Ridge Height",
          "type": "number"
        },
        "spans": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Spans",
          "type": "integer"
        },
        "bays": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Bays",
          "type": "integer"
        },
        "inner_posts": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inner Posts"
        },
        "openings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "title": "Openings",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/Transform",
          "default": {
            "position": {
              "x": 0.0,
              "y": 0.0,
              "z": 0.0
            },
            "rotation": {
              "w": 1.0,
              "x": 0.0,
              "y": 0.0,
              "z": 0.0
            }
          }
        }
      },
      "required": [
        "length",
        "width",
        "eave_height",
        "ridge_height",
        "spans",
        "bays",
        "openings",
        "origin"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "Equipment": {
      "oneOf": [
        {
          "$ref": "#/$defs/Fan"
        },
        {
          "$ref": "#/$defs/Heater"
        },
        {
          "$ref": "#/$defs/Dehumidifier"
        }
      ]
    },
    "Fan": {
      "additionalProperties": false,
      "description": "A fan: a rotor of a diameter, centred on `position`, blowing its rated\nflow of air along its heading.",
      "properties": {
        "actuator_id": {
          "description": "Letters, digits, '_', '.' and '-' only: the API's parameters write it between ':' and ','.",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Actuator Id",
          "type": "string"
        },
        "heading": {
          "default": 0.0,
          "title": "Heading",
          "type": "number"
        },
        "kind": {
          "const": "fan",
          "default": "fan",
          "title": "Kind",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Vector3"
        },
        "diameter_m": {
          "exclusiveMinimum": 0,
          "title": "Diameter M",
          "type": "number"
        },
        "flow_m3_s": {
          "exclusiveMinimum": 0,
          "title": "Flow M3 S",
          "type": "number"
        }
      },
      "required": [
        "actuator_id",
        "heading",
        "kind",
        "position",
        "diameter_m",
        "flow_m3_s"
      ],
      "title": "Fan",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "Something a draft gets wrong, or lacks: a stable code an editor\nreads, a message a person reads, and what it concerns, the layout's\nitems by their ids and the crop rows by their numbers, so that an editor\ncan point at them.",
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "items": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Items",
          "type": "array"
        },
        "rows": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "items",
        "rows"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FixtureKind": {
      "description": "What a fixture is, for every consumer of its geometry.",
      "enum": [
        "crop_gutter",
        "bench",
        "slab",
        "walkway",
        "rail",
        "pipe",
        "wire",
        "obstacle"
      ],
      "title": "FixtureKind",
      "type": "string"
    },
    "Heater": {
      "additionalProperties": false,
      "description": "A unit heater: its rated power, all of it given to the air as heat.",
      "properties": {
        "actuator_id": {
          "description": "Letters, digits, '_', '.' and '-' only: the API's parameters write it between ':' and ','.",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Actuator Id",
          "type": "string"
        },
        "heading": {
          "default": 0.0,
          "title": "Heading",
          "type": "number"
        },
        "base": {
          "$ref": "#/$defs/Vector3"
        },
        "size_x": {
          "exclusiveMinimum": 0,
          "title": "Size X",
          "type": "number"
        },
        "size_y": {
          "exclusiveMinimum": 0,
          "title": "Size Y",
          "type": "number"
        },
        "size_z": {
          "exclusiveMinimum": 0,
          "title": "Size Z",
          "type": "number"
        },
        "kind": {
          "const": "heater",
          "default": "heater",
          "title": "Kind",
          "type": "string"
        },
        "power_w": {
          "exclusiveMinimum": 0,
          "title": "Power W",
          "type": "number"
        }
      },
      "required": [
        "actuator_id",
        "heading",
        "base",
        "size_x",
        "size_y",
        "size_z",
        "kind",
        "power_w"
      ],
      "title": "Heater",
      "type": "object"
    },
    "Imperfections": {
      "additionalProperties": false,
      "description": "How a sensor errs, each in its own unit; all nothing for a clean one.\n\nNoise is Gaussian, of a standard deviation; a reading is rounded to the\nquantization step; a fixed bias is added, and a drift that grows linearly\nwith time since the run's start; a sample drops out with a probability;\nand a reading is delivered a fixed time after its sample.",
      "properties": {
        "noise_sd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Noise Sd",
          "type": "number"
        },
        "quantization": {
          "default": 0.0,
          "minimum": 0,
          "title": "Quantization",
          "type": "number"
        },
        "bias": {
          "default": 0.0,
          "title": "Bias",
          "type": "number"
        },
        "drift_per_hour": {
          "default": 0.0,
          "title": "Drift Per Hour",
          "type": "number"
        },
        "dropout": {
          "default": 0.0,
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Dropout",
          "type": "number"
        },
        "latency_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Latency S",
          "type": "number"
        }
      },
      "required": [
        "noise_sd",
        "quantization",
        "bias",
        "drift_per_hour",
        "dropout",
        "latency_s"
      ],
      "title": "Imperfections",
      "type": "object"
    },
    "Installation": {
      "additionalProperties": false,
      "description": "A greenhouse as authored: no weather, period, control or policy,\nwhich are a scenario's.",
      "properties": {
        "installation_id": {
          "description": "Letters, digits, '_', '.' and '-' only: the API's parameters write it between ':' and ','.",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Installation Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "envelope": {
          "$ref": "#/$defs/Envelope"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        },
        "row_crops": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RowCrop"
          },
          "title": "Row Crops",
          "type": "array"
        }
      },
      "required": [
        "installation_id",
        "name",
        "envelope",
        "layout",
        "row_crops"
      ],
      "title": "Installation",
      "type": "object"
    },
    "Layout": {
      "additionalProperties": false,
      "description": "What stands inside a greenhouse, in metres, in its frame.",
      "properties": {
        "crop_rows": {
          "anyOf": [
            {
              "$ref": "#/$defs/CropRows"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "placed": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Primitive"
          },
          "title": "Placed",
          "type": "array"
        },
        "zones": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "title": "Zones",
          "type": "array"
        },
        "equipment": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Equipment"
          },
          "title": "Equipment",
          "type": "array"
        },
        "sensors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Sensor"
          },
          "title": "Sensors",
          "type": "array"
        }
      },
      "required": [
        "crop_rows",
        "placed",
        "zones",
        "equipment",
        "sensors"
      ],
      "title": "Layout",
      "type": "object"
    },
    "Material": {
      "description": "What a fixture, or a part of the envelope, is made of.",
      "enum": [
        "steel",
        "aluminium",
        "plastic",
        "concrete",
        "substrate"
      ],
      "title": "Material",
      "type": "string"
    },
    "Obstruction": {
      "description": "What a fixture stands in the way of.",
      "enum": [
        "movement",
        "airflow",
        "light"
      ],
      "title": "Obstruction",
      "type": "string"
    },
    "Opening": {
      "description": "A door or vent: a rectangle on its host surface, centred at `centre` in\nthe host's own x-y plane, `width` along the host's x and `height` along\nits y, open by `opening`, from 0 (closed) to 1.",
      "properties": {
        "opening_id": {
          "description": "Letters, digits, '_', '.' and '-' only: the API's parameters write it between ':' and ','.",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Opening Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OpeningKind"
        },
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        },
        "centre": {
          "$ref": "#/$defs/Point2"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "opening": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opening",
          "type": "number"
        },
        "largest_angle": {
          "default": 0.7853981633974483,
          "exclusiveMinimum": 0.0,
          "maximum": 1.5707963267948966,
          "title": "Largest Angle",
          "type": "number"
        }
      },
      "required": [
        "opening_id",
        "kind",
        "surface_id",
        "centre",
        "width",
        "height",
        "opening",
        "largest_angle"
      ],
      "title": "Opening",
      "type": "object"
    },
    "OpeningKind": {
      "enum": [
        "door",
        "roof_vent",
        "side_vent"
      ],
      "title": "OpeningKind",
      "type": "string"
