{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Bearing": {
      "exclusiveMaximum": 360.0,
      "minimum": 0.0,
      "type": "number"
    },
    "BuoyancyAirflow": {
      "additionalProperties": false,
      "description": "Convection: air rising up the middle and sinking along the side walls,\nover air warming with height and towards the middle.",
      "properties": {
        "peak_speed_m_s": {
          "default": 0.25,
          "minimum": 0,
          "title": "Peak Speed M S",
          "type": "number"
        },
        "floor_temperature_c": {
          "default": 18.0,
          "title": "Floor Temperature C",
          "type": "number"
        },
        "ceiling_temperature_c": {
          "default": 23.0,
          "title": "Ceiling Temperature C",
          "type": "number"
        },
        "middle_warming_c": {
          "default": 1.5,
          "minimum": 0,
          "title": "Middle Warming C",
          "type": "number"
        }
      },
      "title": "BuoyancyAirflow",
      "type": "object"
    },
    "CfdSetup": {
      "additionalProperties": false,
      "description": "What drives a scenario's air in a CFD solve, and for how long.",
      "properties": {
        "inlets": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inlets"
        },
        "inlet_speed_m_s": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "title": "Inlet Speed M S",
          "type": "number"
        },
        "effective_viscosity_m2_s": {
          "default": 0.01,
          "exclusiveMinimum": 0,
          "title": "Effective Viscosity M2 S",
          "type": "number"
        },
        "iterations": {
          "default": 2000,
          "exclusiveMinimum": 0,
          "title": "Iterations",
          "type": "integer"
        }
      },
      "title": "CfdSetup",
      "type": "object"
    },
    "CirculationLoop": {
      "additionalProperties": false,
      "description": "Run the fans `fans` while the vents stand open at stage `from_stage`,\ncounted from 1, or beyond.",
      "properties": {
        "fans": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fans",
          "type": "array"
        },
        "from_stage": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "From Stage",
          "type": "integer"
        }
      },
      "required": [
        "fans"
      ],
      "title": "CirculationLoop",
      "type": "object"
    },
    "ConstantWeather": {
      "additionalProperties": false,
      "description": "One weather for the whole of a run, by default a calm 10 °C at 80%,\nits pressure the standard atmosphere's at its site's elevation unless\ngiven.",
      "properties": {
        "air_temperature_c": {
          "default": 10.0,
          "title": "Air Temperature C",
          "type": "number"
        },
        "relative_humidity_pct": {
          "$ref": "#/$defs/Percent",
          "default": 80.0
        },
        "co2_ppm": {
          "default": 420.0,
          "exclusiveMinimum": 0,
          "title": "Co2 Ppm",
          "type": "number"
        },
        "wind_speed_m_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Wind Speed M S",
          "type": "number"
        },
        "wind_direction_deg": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bearing"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.0
        },
        "global_radiation_w_m2": {
          "default": 0.0,
          "minimum": 0,
          "title": "Global Radiation W M2",
          "type": "number"
        },
        "cloud_cover_pct": {
          "$ref": "#/$defs/Percent",
          "default": 0.0
        },
        "barometric_pressure_hpa": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Barometric Pressure Hpa"
        }
      },
      "title": "ConstantWeather",
      "type": "object"
    },
    "Control": {
      "additionalProperties": false,
      "description": "A greenhouse's climate controller: its loops, a day from\n`day_from_s` and a night from `night_from_s`, times of a run's day on\nthe minute that every loop's targets share, and the dead band\n`dead_band_c` that keeps heating and venting apart: in each period, the\nvents' first stage closes above the temperature the heater switches off\nat by at least that much.",
      "properties": {
        "day_from_s": {
          "$ref": "#/$defs/TimeOfDay",
          "default": 25200.0
        },
        "night_from_s": {
          "$ref": "#/$defs/TimeOfDay",
          "default": 68400.0
        },
        "dead_band_c": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Dead Band C",
          "type": "number"
        },
        "heating": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeatingLoop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "venting": {
          "anyOf": [
            {
              "$ref": "#/$defs/VentingLoop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "circulation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CirculationLoop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dehumidifying": {
          "anyOf": [
            {
              "$ref": "#/$defs/DehumidifyingLoop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Control",
      "type": "object"
    },
    "CropModel": {
      "description": "How a scenario's run grows its crop: by the simple daily model,\nthrough the engine, or organ by organ (`greenhouse_sim.core.crop`).",
      "enum": [
        "simple",
        "organ"
      ],
      "title": "CropModel",
      "type": "string"
    },
    "CropWalk": {
      "additionalProperties": false,
      "description": "The daily walk through the crop's measurement errors, on either\ncrop's walk (`greenhouse_sim.services.crop_log`, and the engine's\nsensors): the chance that a count is one off, and the standard\ndeviations of the ripe fruits' estimated mass, in percent, and of a\nplant's measured height, in cm.",
      "properties": {
        "fruit_count_noise_probability": {
          "default": 0.1,
          "title": "Fruit Count Noise Probability",
          "type": "number"
        },
        "ripe_mass_noise_pct": {
          "default": 8.0,
          "title": "Ripe Mass Noise Pct",
          "type": "number"
        },
        "height_noise_cm": {
          "default": 1.5,
          "title": "Height Noise Cm",
          "type": "number"
        }
      },
      "title": "CropWalk",
      "type": "object"
    },
    "CropWork": {
      "additionalProperties": false,
      "description": "What a run does to its crop, at the start of its days: a harvest round\nevery `harvest_every_days` days from its start, picking every red fruit;\nand then a lowering round every `lower_every_days`, which leaves each\nplant hanging from a wire with its top `head_room_m` or more under it;\nneither if unset.",
      "properties": {
        "harvest_every_days": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harvest Every Days"
        },
        "lower_every_days": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Every Days"
        },
        "head_room_m": {
          "default": 0.3,
          "minimum": 0,
          "title": "Head Room M",
          "type": "number"
        }
      },
      "title": "CropWork",
      "type": "object"
    },
    "DailyCommand": {
      "additionalProperties": false,
      "description": "Set one piece of equipment to a level at a time of day, every day of\na run.",
      "properties": {
        "time_of_day_s": {
          "exclusiveMaximum": 86400.0,
          "minimum": 0.0,
          "title": "Time Of Day S",
          "type": "number"
        },
        "actuator_id": {
          "title": "Actuator Id",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Level"
        }
      },
      "required": [
        "time_of_day_s",
        "actuator_id",
        "level"
      ],
      "title": "DailyCommand",
      "type": "object"
    },
    "DehumidifyingLoop": {
      "additionalProperties": false,
      "description": "Dry the house's air to `target_pct` relative humidity: the\ndehumidifier `actuator_id` on above the target by half `band_pct`, off\nbelow it by as much. With `vents_when_drier`, the vents' first stage\nopens too, while this loop is on, the heater off, and the air outside is\ndrier than the house's: its humidity ratio lower by `drier_by_g_kg`,\nuntil it is lower by less than that less `drier_band_g_kg`.",
      "properties": {
        "actuator_id": {
          "title": "Actuator Id",
          "type": "string"
        },
        "target_pct": {
          "$ref": "#/$defs/HumidityPct"
        },
        "band_pct": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "title": "Band Pct",
          "type": "number"
        },
        "vents_when_drier": {
          "default": true,
          "title": "Vents When Drier",
          "type": "boolean"
        },
        "drier_by_g_kg": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Drier By G Kg",
          "type": "number"
        },
        "drier_band_g_kg": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "title": "Drier Band G Kg",
          "type": "number"
        }
      },
      "required": [
        "actuator_id",
        "target_pct"
      ],
      "title": "DehumidifyingLoop",
      "type": "object"
    },
    "Envelope": {
      "description": "A greenhouse's envelope, in metres, no larger than any greenhouse.",
      "properties": {
        "length": {
          "exclusiveMinimum": 0,
          "maximum": 500.0,
          "title": "Length",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 500.0,
          "title": "Width",
          "type": "number"
        },
        "eave_height": {
          "exclusiveMinimum": 0,
          "maximum": 50.0,
          "title": "Eave Height",
          "type": "number"
        },
        "ridge_height": {
          "exclusiveMinimum": 0,
          "maximum": 50.0,
          "title": "Ridge Height",
          "type": "number"
        },
        "spans": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Spans",
          "type": "integer"
        },
        "bays": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Bays",
          "type": "integer"
        },
        "inner_posts": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inner Posts"
        },
        "openings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "title": "Openings",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/Transform",
          "default": {
            "position": {
              "x": 0.0,
              "y": 0.0,
              "z": 0.0
            },
            "rotation": {
              "w": 1.0,
              "x": 0.0,
              "y": 0.0,
              "z": 0.0
            }
          }
        }
      },
      "required": [
        "length",
        "width",
        "eave_height",
        "ridge_height"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "GradientAirflow": {
      "additionalProperties": false,
      "description": "Still air whose temperature rises linearly along the house: a known\nfield to check sensors against.",
      "properties": {
        "front_temperature_c": {
          "default": 16.0,
          "title": "Front Temperature C",
          "type": "number"
        },
        "rise_c_per_m": {
          "default": 0.5,
          "title": "Rise C Per M",
          "type": "number"
        }
      },
      "title": "GradientAirflow",
      "type": "object"
    },
    "GridAir": {
      "additionalProperties": false,
      "description": "The house's air cell by cell, on the field's grid, beside the whole\nhouse's (`greenhouse_sim.climate.day`): the house air's model that draws\nwhere its air is warm, damp or still, its parameters a climate run's.",
      "properties": {
        "start_temperature_c": {
          "default": 18.0,
          "title": "Start Temperature C",
          "type": "number"
        },
        "start_humidity_pct": {
          "$ref": "#/$defs/Percent",
          "default": 75.0
        },
        "start_co2_ppm": {
          "default": 420.0,
          "exclusiveMinimum": 0,
          "title": "Start Co2 Ppm",
          "type": "number"
        },
        "glazing_u_w_m2k": {
          "default": 6.0,
          "exclusiveMaximum": 20.389419544452608,
          "minimum": 0.0,
          "title": "Glazing U W M2K",
          "type": "number"
        },
        "infiltration_per_h": {
          "default": 0.25,
          "minimum": 0,
          "title": "Infiltration Per H",
          "type": "number"
        },
        "infiltration_per_h_per_m_s": {
          "default": 0.1,
          "minimum": 0,
          "title": "Infiltration Per H Per M S",
          "type": "number"
        },
        "mixing_m2_s": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "title": "Mixing M2 S",
          "type": "number"
        }
      },
      "title": "GridAir",
      "type": "object"
    },
    "HeatingLoop": {
      "additionalProperties": false,
      "description": "Heat the house's air with the heater `actuator_id` to `day_c` by day\nand `night_c` by night: on below the setpoint by half `band_c`, off above\nit by as much (decision 0042's thermostat).",
      "properties": {
        "actuator_id": {
          "title": "Actuator Id",
          "type": "string"
        },
        "day_c": {
          "title": "Day C",
          "type": "number"
        },
        "night_c": {
          "title": "Night C",
          "type": "number"
        },
        "band_c": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Band C",
          "type": "number"
        }
      },
      "required": [
        "actuator_id",
        "day_c",
        "night_c"
      ],
      "title": "HeatingLoop",
      "type": "object"
    },
    "Hour": {
      "exclusiveMaximum": 24,
      "minimum": 0.0,
      "type": "number"
    },
    "HumidityPct": {
      "exclusiveMaximum": 100.0,
      "exclusiveMinimum": 0.0,
      "type": "number"
    },
    "Installation": {
      "additionalProperties": false,
      "description": "A greenhouse as authored: no weather, period, control or policy,\nwhich are a scenario's.",
      "properties": {
        "installation_id": {
          "description": "Letters, digits, '_', '.' and '-' only: the API's parameters write it between ':' and ','.",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Installation Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "envelope": {
          "$ref": "#/$defs/Envelope"
        },
        "layout": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "default": "default",
          "description": "The name of one of the scenario's layout files."
        },
        "row_crops": {
          "items": {
            "$ref": "#/$defs/RowCrop"
          },
          "title": "Row Crops",
          "type": "array",
          "minItems": 1
        }
      },
      "required": [
        "installation_id",
        "name",
        "envelope",
        "row_crops"
      ],
      "title": "Installation",
      "type": "object"
    },
    "Level": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "NoParameters": {
      "additionalProperties": false,
      "description": "The parameters of a model that takes none.",
      "properties": {},
      "title": "NoParameters",
      "type": "object"
    },
    "Opening": {
      "description": "A door or vent: a rectangle on its host surface, centred at `centre` in\nthe host's own x-y plane, `width` along the host's x and `height` along\nits y, open by `opening`, from 0 (closed) to 1.",
      "properties": {
        "opening_id": {
          "description": "Letters, digits, '_', '.' and '-' only: the API's parameters write it between ':' and ','.",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Opening Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/OpeningKind"
        },
        "surface_id": {
          "title": "Surface Id",
          "type": "string"
        },
        "centre": {
          "$ref": "#/$defs/Point2"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "opening": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Opening",
          "type": "number"
        },
        "largest_angle": {
          "default": 0.7853981633974483,
          "exclusiveMinimum": 0.0,
          "maximum": 1.5707963267948966,
          "title": "Largest Angle",
          "type": "number"
        }
      },
      "required": [
        "opening_id",
        "kind",
        "surface_id",
        "centre",
        "width",
        "height"
      ],
      "title": "Opening",
      "type": "object"
    },
    "OpeningKind": {
      "enum": [
        "door",
        "roof_vent",
        "side_vent"
      ],
      "title": "OpeningKind",
      "type": "string"
    },
    "OrganCrop": {
      "additionalProperties": false,
      "description": "The organ crop's settings (`greenhouse_sim.biology.tomato.organ`):\nnone a scenario chooses yet, its variety's being its own (P12.4).",
      "properties": {},
      "title": "OrganCrop",
      "type": "object"
    },
    "Percent": {
      "maximum": 100.0,
      "minimum": 0.0,
      "type": "number"
    },
    "Persistence": {
      "exclusiveMaximum": 0.8,
      "minimum": 0.0,
      "type": "number"
    },
    "Point2": {
      "description": "A point in a shape's own x-y plane.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point2",
      "type": "object"
    },
    "Quaternion": {
      "description": "A rotation as a unit quaternion; the default is no rotation.",
      "properties": {
        "w": {
          "default": 1.0,
          "title": "W",
          "type": "number"
        },
        "x": {
          "default": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "title": "Z",
          "type": "number"
        }
      },
      "title": "Quaternion",
      "type": "object"
    },
    "RecordedWeather": {
      "additionalProperties": false,
      "description": "Weather recorded in a file of the recorded weather's directory, by its\nname.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "RecordedWeather",
      "type": "object"
    },
    "RowCrop": {
      "additionalProperties": false,
      "description": "The crop one row grows: its model and its variety. Rows are numbered\nfrom 1, as `CropRows` numbers them.",
      "properties": {
        "row": {
          "exclusiveMinimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "crop_model": {
          "$ref": "#/$defs/CropModel"
        },
        "variety": {
          "minLength": 1,
          "title": "Variety",
          "type": "string"
        }
      },
      "required": [
        "row",
        "crop_model",
        "variety"
      ],
      "title": "RowCrop",
      "type": "object"
    },
    "SeasonalWeather": {
      "additionalProperties": false,
      "description": "Weather through a season: each day's usual coldest and warmest\ntemperatures on the year's coldest day and half a year later, which day\nof the year is coldest, how far a day's temperatures wander from their\nusual ones and how much of that a day keeps from the day before, and\neach day's clouds; and a synthetic day's shape, humidity and wind.",
      "properties": {
        "coldest_c": {
          "$ref": "#/$defs/Seasons"
        },
        "warmest_c": {
          "$ref": "#/$defs/Seasons"
        },
        "coldest_day": {
          "default": 20,
          "maximum": 366,
          "minimum": 1,
          "title": "Coldest Day",
          "type": "integer"
        },
        "day_to_day_c": {
          "default": 0.0,
          "minimum": 0,
          "title": "Day To Day C",
          "type": "number"
        },
        "persistence": {
          "$ref": "#/$defs/Persistence",
          "default": 0.0
        },
        "coldest_hour": {
          "$ref": "#/$defs/Hour"
        },
        "warmest_hour": {
          "$ref": "#/$defs/Hour"
        },
        "humidity_at_coldest_pct": {
          "$ref": "#/$defs/Percent"
        },
        "co2_ppm": {
          "default": 420.0,
          "exclusiveMinimum": 0,
          "title": "Co2 Ppm",
          "type": "number"
        },
        "calmest_m_s": {
          "minimum": 0,
          "title": "Calmest M S",
          "type": "number"
        },
        "windiest_m_s": {
          "minimum": 0,
          "title": "Windiest M S",
          "type": "number"
        },
        "wind_from_deg": {
          "$ref": "#/$defs/Bearing"
        },
        "veer_deg": {
          "default": 0.0,
          "title": "Veer Deg",
          "type": "number"
        },
        "gustiness": {
          "default": 0.0,
          "minimum": 0,
          "title": "Gustiness",
          "type": "number"
        },
        "cloud_cover_pct": {
          "$ref": "#/$defs/Percent",
          "default": 0.0
        },
